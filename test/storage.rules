rules_version = '2';

// Firebase Storage is NOT used by this app: every image (hour-sheet scans, reply images, signatures)
// is stored inline in Firestore as a size-capped data URL, validated by firestore.rules.
// Deny everything so a future bucket cannot be read or written by accident.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
