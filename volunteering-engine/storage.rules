rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /hourSheets/{memberUid}/{logId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == memberUid;
    }

    match /signatures/{orgId}/{logId} {
      allow read, write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
