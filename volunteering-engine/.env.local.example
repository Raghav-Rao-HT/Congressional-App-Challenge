VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional hardening switches (see SECURITY.md before changing any of them)
# reCAPTCHA v3 site key registered in Firebase console -> App Check. Leave blank to skip App Check.
VITE_APPCHECK_SITE_KEY=
# Set to true ONLY after enforceEmailVerification() is flipped in firestore.rules.
VITE_REQUIRE_VERIFIED_EMAIL=false
# Dev only (ignored in production builds): point `npm run dev` at the local emulators instead of prod.
# Use a demo-* project id in the VITE_FIREBASE_* values above when this is true.
VITE_USE_EMULATORS=false
